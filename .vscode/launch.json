{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug (Cortex-Debug)",
            "cwd": "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
            "executable": "${workspaceFolder}/${input:pickELF}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd",
            "gdbPath": "${userHome}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gdb",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load",
                "monitor reset halt"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Pico Debug (external OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/${input:pickELF}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "gdbPath": "${userHome}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gdb",
            "device": "RP2350",
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load",
                "monitor reset halt"
            ]
        },
        {
            "name": "Pico Attach (no flash)",
            "cwd": "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
            "executable": "${workspaceFolder}/${input:pickELF}",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd",
            "gdbPath": "${userHome}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gdb",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Host: pico-amiga (SDL, gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-host/pico-amiga",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build Host",
            "externalConsole": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "handle SIGPIPE nostop noprint", "ignoreFailures": true }
            ]
        },
        {
            "name": "Host: pico-amiga-host (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-host/pico-amiga-host",
            "args": ["--rom", "${input:pickROM}", "--frames", "3000", "--shot", "3000:build-host/debug.png"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build Host",
            "externalConsole": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ],
    "inputs": [
        {
            "id": "pickELF",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "cd ${workspaceFolder} && find build debug -maxdepth 1 -name '*.elf' -printf '%T@\\t%p\\n' 2>/dev/null | sort -rn | cut -f2-",
                "description": "Select ELF file to debug: build/ and debug/ (test builds), most recent first",
                "useFirstResult": false
            }
        },
        {
            "id": "pickROM",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "find ${workspaceFolder}/roms ${workspaceFolder}/debug/Kickstarts/PUAE\\ Bios -maxdepth 1 -type f ! -name '*.ext' 2>/dev/null | sort",
                "description": "Select Kickstart / diagnostic ROM",
                "useFirstResult": false
            }
        }
    ]
}
